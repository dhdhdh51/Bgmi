# Pretty routes: <deploy-dir>/calculate-sensitivity -> <deploy-dir>/index.php
#
# No RewriteBase on purpose: the relative "index.php" target is resolved against
# whichever directory this file sits in, so the API works at /api/, /bgmi/api/
# or the document root without edits.
#
# Where mod_rewrite is unavailable the API still works via
# index.php?route=calculate-sensitivity.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never rewrite requests for files/directories that really exist.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Credentials must never be served directly.
<FilesMatch "^config(\.sample)?\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

Options -Indexes
