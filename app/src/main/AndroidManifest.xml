<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The recommendation quality improves with a gyroscope but the app is
         fully usable without one, so the feature is not required. -->
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BgmiSensitivity"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ManualSelectActivity"
            android:exported="false"
            android:label="@string/title_manual_select"
            android:parentActivityName=".ui.HomeActivity" />

        <activity
            android:name=".ui.ResultsActivity"
            android:exported="false"
            android:label="@string/title_results"
            android:parentActivityName=".ui.HomeActivity" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/title_history"
            android:parentActivityName=".ui.HomeActivity" />

        <activity
            android:name=".ui.FeedbackActivity"
            android:exported="false"
            android:label="@string/title_feedback"
            android:parentActivityName=".ui.HomeActivity" />
    </application>

</manifest>
